{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "term7",
  "version": "../package.json",
  "identifier": "br.tec.code7.term7",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "term7",
        "width": 1000,
        "height": 640,
        "minWidth": 420,
        "minHeight": 260
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Terminal com interface moderna",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": ["git", "gh"],
        "desktopTemplate": "./term7.desktop"
      }
    }
  }
}
