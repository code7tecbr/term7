{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "term7",
  "version": "../package.json",
  "identifier": "br.tec.code7.term7",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run licenses",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "term7",
        "width": 1000,
        "height": 640,
        "minWidth": 420,
        "minHeight": 260
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Terminal com interface moderna",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "git",
          "gh"
        ],
        "desktopTemplate": "./term7.desktop",
        "files": {
          "/usr/share/doc/term7/copyright": "../LICENSE",
          "/usr/share/doc/term7/THIRD_PARTY_LICENSES.md": "THIRD_PARTY_LICENSES.md",
          "/usr/share/term7/extensions/mcp/extension.json": "../extensions/mcp/extension.json",
          "/usr/share/term7/extensions/mcp/term7-mcp": "../extensions/mcp/term7-mcp",
          "/usr/share/term7/extensions/kokoro/extension.json": "../extensions/kokoro/extension.json",
          "/usr/share/term7/extensions/kokoro/term7-kokoro": "../extensions/kokoro/term7-kokoro",
          "/usr/share/term7/extensions/statusbot/extension.json": "../extensions/statusbot/extension.json",
          "/usr/share/term7/extensions/statusbot/term7-statusbot": "../extensions/statusbot/term7-statusbot"
        }
      }
    },
    "license": "MIT",
    "copyright": "Copyright (c) 2026 code7 and the term7 contributors"
  }
}
